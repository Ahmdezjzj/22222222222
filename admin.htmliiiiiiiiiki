    <!-- ===== ADS ===== -->
    <div class="page" id="page-ads">
      <div class="page-title">📢 إدارة الإعلانات</div>
      <div class="card">
        <div class="card-title"><span class="card-title-text">إضافة إعلان جديد</span></div>
        <div class="alert" id="adsAlert"></div>
        <div class="form-grid">
          <div><label>عنوان الإعلان</label><input type="text" id="adTitle" placeholder="إعلان الرئيسية"></div>
          <div><label>رابط الصورة *</label><input type="url" id="adImage" placeholder="https://..." oninput="previewAd()"></div>
          <div><label>رابط الإعلان (عند الضغط)</label><input type="url" id="adLink" placeholder="https://..."></div>
          <div>
            <label>موقع الإعلان</label>
            <select id="adPosition">
              <option value="home_top">الرئيسية — أعلى الصفحة</option>
              <option value="home_middle">الرئيسية — وسط الصفحة</option>
              <option value="home_bottom">الرئيسية — أسفل الصفحة</option>
              <option value="manga_top">صفحة المانجا — أعلى</option>
              <option value="manga_bottom">صفحة المانجا — أسفل</option>
              <option value="reader_top">القارئ — أعلى</option>
              <option value="reader_bottom">القارئ — أسفل</option>
            </select>
          </div>
          <div style="display:flex;align-items:center;gap:8px;padding-top:20px">
            <input type="checkbox" id="adActive" style="width:auto" checked>
            <label style="margin:0">نشط</label>
          </div>
        </div>
        <div id="adPreviewWrap" style="display:none;margin:12px 0">
          <label>معاينة:</label>
          <img id="adPreviewImg" style="max-width:100%;max-height:200px;border-radius:8px;margin-top:6px;display:block">
        </div>
        <br>
        <button class="btn btn-primary" onclick="saveAd()">💾 حفظ الإعلان</button>
      </div>
      <div class="card" style="margin-top:16px">
        <div class="card-title"><span class="card-title-text">الإعلانات الحالية</span></div>
        <div id="adsList">جاري التحميل...</div>
      </div>
    </div>

    <!-- ===== EDIT MANGA ===== -->
    <div class="page" id="page-editManga">
      <div class="page-title">✏️ تعديل المانجا</div>
      <div class="card">
        <div class="alert" id="editAlert"></div>
        <div style="margin-bottom:20px;padding:16px;background:var(--card2);border-radius:10px;border:1px solid var(--border2)">
          <label>🔍 جلب معلومات تلقائياً من MangaDex</label>
          <div style="display:flex;gap:8px;margin-top:8px">
            <input type="text" id="editFetchTitle" placeholder="اسم المانجا بالإنجليزي" style="flex:1">
            <button class="btn btn-blue" onclick="fetchInfoEdit()">جلب</button>
          </div>
        </div>
        <input type="hidden" id="editMangaId">
        <div class="form-grid">
          <div><label>عنوان المانجا *</label><input type="text" id="editTitle"></div>
          <div><label>المؤلف</label><input type="text" id="editAuthor"></div>
          <div><label>صورة الغلاف (رابط)</label><input type="url" id="editCover" oninput="updateEditCoverPreview()"></div>
          <div><label>النوع</label>
            <select id="editType">
              <option value="manhwa">مانهوا 🇰🇷</option>
              <option value="manga">مانجا 🇯🇵</option>
              <option value="manhua">مانهوا صينية 🇨🇳</option>
            </select>
          </div>
          <div><label>الحالة</label>
            <select id="editStatus">
              <option value="ongoing">مستمر 🔄</option>
              <option value="completed">مكتمل ✅</option>
            </select>
          </div>
          <div><label>التصنيفات (مفصولة بفواصل)</label><input type="text" id="editGenres"></div>
          <div style="display:flex;align-items:center;gap:8px;padding-top:20px">
            <input type="checkbox" id="editHot" style="width:auto">
            <label style="margin:0">🔥 مشهور</label>
          </div>
          <div style="display:flex;align-items:center;gap:8px;padding-top:20px">
            <input type="checkbox" id="editNew" style="width:auto">
            <label style="margin:0">🆕 جديد</label>
          </div>
        </div>
        <div id="editCoverPreview" style="display:none;margin:12px 0">
          <label>معاينة الغلاف:</label>
          <img id="editCoverImg" style="height:120px;border-radius:8px;margin-top:6px;display:block">
        </div>
        <div style="margin-top:12px">
          <label>القصة</label>
          <textarea id="editDesc" rows="5" style="width:100%;resize:vertical"></textarea>
        </div>
        <br>
        <div style="display:flex;gap:10px">
          <button class="btn btn-primary" onclick="updateManga()">💾 حفظ التعديلات</button>
          <button class="btn btn-secondary" onclick="showPage('manga')">إلغاء</button>
        </div>
      </div>
    </div>

    <!-- ===== SETTINGS ===== -->
    <div class="page" id="page-settings">
      <div class="page-title">⚙️ إعدادات الموقع</div>
      <div class="card">
        <div class="alert" id="settingsAlert"></div>
        <div class="settings-row">
          <div><div class="settings-label">اسم الموقع</div><div class="settings-sub">يظهر في الشريط العلوي والعنوان</div></div>
          <input type="text" id="setSiteName" placeholder="مانجا كلاود" style="width:200px">
        </div>
        <div class="settings-row">
          <div><div class="settings-label">وصف الموقع</div><div class="settings-sub">يظهر في صفحة الرئيسية</div></div>
          <input type="text" id="setSiteDesc" placeholder="اقرأ المانجا المترجمة" style="width:200px">
        </div>
        <div class="settings-row">
          <div><div class="settings-label">نمط الهيرو</div><div class="settings-sub">طريقة عرض البانر الرئيسي</div></div>
          <select id="setHeroStyle" style="width:160px">
            <option value="slider">سلايدر</option>
            <option value="static">صورة ثابتة</option>
          </select>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">عدد الفصول في الصفحة</div></div>
          <input type="number" id="setChPerPage" placeholder="20" style="width:100px">
        </div>
        <br>
        <button class="btn btn-primary" onclick="saveSettings()">💾 حفظ الإعدادات</button>
      </div>
    </div>

    <!-- ===== APPEARANCE ===== -->
    <div class="page" id="page-appearance">
      <div class="page-title">🎨 المظهر والألوان</div>
      <div class="card">
        <div class="alert" id="appearanceAlert"></div>
        <div class="settings-row">
          <div><div class="settings-label">اللون الأساسي</div><div class="settings-sub">لون الأزرار والروابط والتأثيرات</div></div>
          <input type="color" class="color-input" id="setPrimary" value="#e63946">
        </div>
        <div class="settings-row">
          <div><div class="settings-label">اللون الثانوي</div><div class="settings-sub">للتدرجات والتأثيرات الثانوية</div></div>
          <input type="color" class="color-input" id="setSecondary" value="#ff6b6b">
        </div>
        <div class="settings-row">
          <div><div class="settings-label">لون الخلفية</div><div class="settings-sub">لون خلفية الموقع الرئيسي</div></div>
          <input type="color" class="color-input" id="setBg" value="#0a0a0f">
        </div>
        <div class="settings-row">
          <div><div class="settings-label">لون البطاقات</div><div class="settings-sub">لون خلفية البطاقات والعناصر</div></div>
          <input type="color" class="color-input" id="setCard" value="#16161f">
        </div>
        <br>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <button class="btn btn-primary" onclick="saveAppearance()">💾 حفظ المظهر</button>
          <button class="btn btn-secondary" onclick="resetAppearance()">↺ استعادة الافتراضي</button>
        </div>
      </div>
    </div>

  </main>
</div>

<script>
// ======== AUTH ========
let token = localStorage.getItem('adminToken') || '';
let vaultsList = [];
let mangaList = [];

async function login() {
  const t = document.getElementById('tokenInput').value;
  try {
    const res = await fetch('/api/admin/stats', {
      headers: { Authorization: `Bearer ${t}` }
    });
    if (res.ok) {
      token = t;
      localStorage.setItem('adminToken', t);
      document.getElementById('loginWrap').style.display = 'none';
      document.getElementById('app').style.display = 'grid';
      document.getElementById('topToken').textContent = '🔑 مسجل الدخول';
      initApp();
    } else {
      document.getElementById('loginErr').style.display = 'block';
    }
  } catch(e) {
    document.getElementById('loginErr').style.display = 'block';
  }
}

// تحقق تلقائي
window.addEventListener('load', async () => {
  if (token) {
    try {
      const res = await fetch('/api/admin/stats', { headers: { Authorization: `Bearer ${token}` } });
      if (res.ok) {
        document.getElementById('loginWrap').style.display = 'none';
        document.getElementById('app').style.display = 'grid';
        document.getElementById('topToken').textContent = '🔑 مسجل الدخول';
        initApp();
        return;
      }
    } catch(e) {}
  }
});

// ======== INIT ========
async function initApp() {
  await loadDashboard();
  await loadVaults();
  await loadMangaList();
  await loadAdminSettings();
}

// ======== NAVIGATION ========
function showPage(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.side-item').forEach(s => s.classList.remove('active'));
  document.getElementById('page-' + name)?.classList.add('active');
  event?.currentTarget?.classList.add('active');

  if (name === 'manga') renderMangaTable();
  if (name === 'vaults') renderVaultsList();
  if (name === 'ads') loadAds();
  if (name === 'importChapter' || name === 'importManga') fillSelects();
}

// ======== DASHBOARD ========
async function loadDashboard() {
  try {
    const stats = await adminApi('/api/admin/stats');
    const iconMap = {
      manga: { icon: '📚', color: '#e63946', label: 'مانجا' },
      chapters: { icon: '📑', color: '#3b82f6', label: 'فصول' },
      vaults: { icon: '🗄️', color: '#f59e0b', label: 'K-Vaults' },
      views: { icon: '👁️', color: '#22c55e', label: 'مشاهدة' },
    };
    document.getElementById('statsGrid').innerHTML = Object.entries(stats).map(([k, v]) => {
      const m = iconMap[k] || { icon: '📊', color: '#888', label: k };
      return `
        <div class="stat-card">
          <div class="stat-icon" style="background:${m.color}20;color:${m.color}">${m.icon}</div>
          <div class="stat-info">
            <div class="stat-val">${Number(v||0).toLocaleString('ar')}</div>
            <div class="stat-label">${m.label}</div>
          </div>
        </div>
      `;
    }).join('');

    const mangaData = await adminApi('/api/admin/manga');
    const recent = (mangaData.manga || []).slice(0, 5);
    document.getElementById('recentManga').innerHTML = recent.length
      ? `<div style="display:flex;flex-direction:column;gap:8px">${recent.map(m => `
          <div style="display:flex;align-items:center;gap:12px;padding:10px;background:var(--card2);border-radius:8px">
            ${m.cover ? `<img src="${m.cover}" style="width:36px;height:50px;border-radius:6px;object-fit:cover">` : `<div style="width:36px;height:50px;border-radius:6px;background:var(--surface);display:flex;align-items:center;justify-content:center">📖</div>`}
            <div style="flex:1"><div style="font-weight:700;font-size:14px">${m.title}</div><div style="font-size:11px;color:var(--muted)">${m.chapter_count} فصل</div></div>
            <a href="/manga.html?slug=${m.slug}" target="_blank" style="color:var(--primary);font-size:13px">عرض →</a>
          </div>
        `).join('')}</div>`
      : '<div style="text-align:center;padding:30px;color:var(--muted)">لا توجد مانجا بعد</div>';
  } catch(e) {}
}

// ======== MANGA ========
async function loadMangaList() {
  try {
    const data = await adminApi('/api/admin/manga');
    mangaList = data.manga || [];
  } catch(e) {}
}

function renderMangaTable() {
  const el = document.getElementById('mangaListContent');
  if (!mangaList.length) {
    el.innerHTML = '<div style="text-align:center;padding:40px;color:var(--muted)">لا توجد مانجا — أضف أولى!</div>';
    return;
  }
  el.innerHTML = `
    <div class="table-wrap">
      <table>
        <thead><tr><th>الغلاف</th><th>العنوان</th><th>الفصول</th><th>النوع</th><th>الحالة</th><th>إجراءات</th></tr></thead>
        <tbody>${mangaList.map(m => `
          <tr>
            <td>${m.cover ? `<img src="${m.cover}" class="manga-row-cover">` : `<div class="manga-row-cover-ph">📖</div>`}</td>
            <td><div class="manga-title-cell">${m.title}</div><div class="manga-title-sub">${m.slug}</div></td>
            <td>${m.chapter_count || 0}</td>
            <td>${typeLabel(m.type)}</td>
            <td>${m.status === 'completed' ? '✅ مكتمل' : '🔄 مستمر'}</td>
            <td>
              <div class="td-actions">
                <a href="/manga.html?slug=${m.slug}" target="_blank" class="btn btn-secondary btn-sm">👁️</a>
                <button class="btn btn-blue btn-sm" onclick="openEditManga(${m.id})">✏️</button>
                <button class="btn btn-red btn-sm" onclick="deleteManga(${m.id}, '${m.title}')">🗑️</button>
              </div>
            </td>
          </tr>
        `).join('')}</tbody>
      </table>
    </div>
  `;
}

async function addManga() {
  const title = document.getElementById('mTitle').value.trim();
  if (!title) { showAlert('addAlert', '❌ أدخل عنوان المانجا!', 'error'); return; }

  try {
    const res = await adminApi('/api/admin/manga', 'POST', {
      title,
      author: document.getElementById('mAuthor').value.trim(),
      cover: document.getElementById('mCover').value.trim(),
      type: document.getElementById('mType').value,
      status: document.getElementById('mStatus').value,
      genres: document.getElementById('mGenres').value.trim(),
      description: document.getElementById('mDesc').value.trim(),
      is_hot: document.getElementById('mHot').checked,
      is_new: document.getElementById('mNew').checked,
    });

    if (res.success) {
      showAlert('addAlert', `✅ تمت إضافة "${title}" بنجاح! <a href="/manga.html?slug=${res.slug}" target="_blank" style="color:inherit">عرض ←</a>`, 'success');
      ['mTitle','mAuthor','mCover','mGenres','mDesc'].forEach(id => document.getElementById(id).value = '');
      await loadMangaList();
    } else {
      showAlert('addAlert', '❌ ' + (res.error || 'خطأ'), 'error');
    }
  } catch(e) {
    showAlert('addAlert', '❌ خطأ في الاتصال', 'error');
  }
}

async function fetchInfo() {
  const title = document.getElementById('fetchTitle').value.trim();
  if (!title) return;
  const btn = event.target;
  btn.disabled = true; btn.innerHTML = '<div class="spinner"></div>';

  try {
    const info = await adminApi('/api/admin/kvault/fetch-info', 'POST', { title });
    if (info.found) {
      document.getElementById('mTitle').value = info.title || title;
      document.getElementById('mCover').value = info.cover || '';
      document.getElementById('mGenres').value = info.genres || '';
      document.getElementById('mDesc').value = info.description || '';
      document.getElementById('mAuthor').value = info.author || '';
      if (info.type) document.getElementById('mType').value = info.type;
      if (info.cover) {
        document.getElementById('mCoverImg').src = info.cover;
        document.getElementById('mCoverPreview').style.display = 'block';
      }
      showAlert('addAlert', '✅ تم جلب المعلومات من MangaDex!', 'success');
    } else {
      showAlert('addAlert', '⚠️ لم يتم العثور على المانجا في MangaDex — يمكنك إدخال المعلومات يدوياً.', 'info');
    }
  } catch(e) {}
  btn.disabled = false; btn.innerHTML = 'جلب';
}

async function deleteManga(id, title) {
  if (!confirm(`هل تريد حذف "${title}"؟ سيتم حذف جميع الفصول أيضاً.`)) return;
  try {
    await adminApi(`/api/admin/manga/${id}`, 'DELETE');
    await loadMangaList();
    renderMangaTable();
  } catch(e) {}
}

// ======== EDIT MANGA ========
function openEditManga(id) {
  const m = mangaList.find(x => x.id === id);
  if (!m) return;
  document.getElementById('editMangaId').value = m.id;
  document.getElementById('editTitle').value = m.title || '';
  document.getElementById('editAuthor').value = m.author || '';
  document.getElementById('editCover').value = m.cover || '';
  document.getElementById('editGenres').value = m.genres || '';
  document.getElementById('editDesc').value = m.description || '';
  document.getElementById('editType').value = m.type || 'manhwa';
  document.getElementById('editStatus').value = m.status || 'ongoing';
  document.getElementById('editHot').checked = !!m.is_hot;
  document.getElementById('editNew').checked = !!m.is_new;
  document.getElementById('editFetchTitle').value = m.title || '';
  if (m.cover) {
    document.getElementById('editCoverImg').src = m.cover;
    document.getElementById('editCoverPreview').style.display = 'block';
  } else {
    document.getElementById('editCoverPreview').style.display = 'none';
  }
  showPage('editManga');
}

function updateEditCoverPreview() {
  const url = document.getElementById('editCover').value.trim();
  if (url) {
    document.getElementById('editCoverImg').src = url;
    document.getElementById('editCoverPreview').style.display = 'block';
  } else {
    document.getElementById('editCoverPreview').style.display = 'none';
  }
}

async function fetchInfoEdit() {
  const title = document.getElementById('editFetchTitle').value.trim();
  if (!title) return;
  const btn = event.target;
  btn.disabled = true; btn.innerHTML = '<div class="spinner"></div>';
  try {
    const info = await adminApi('/api/admin/kvault/fetch-info', 'POST', { title });
    if (info.found) {
      if (info.cover) {
        document.getElementById('editCover').value = info.cover;
        document.getElementById('editCoverImg').src = info.cover;
        document.getElementById('editCoverPreview').style.display = 'block';
      }
      if (info.genres) document.getElementById('editGenres').value = info.genres;
      if (info.description) document.getElementById('editDesc').value = info.description;
      if (info.author) document.getElementById('editAuthor').value = info.author;
      if (info.type) document.getElementById('editType').value = info.type;
      showAlert('editAlert', '✅ تم جلب المعلومات بالعربية من MangaDex!', 'success');
    } else {
      showAlert('editAlert', '⚠️ لم يتم العثور على المانجا في MangaDex', 'info');
    }
  } catch(e) { showAlert('editAlert', '❌ خطأ في الجلب', 'error'); }
  btn.disabled = false; btn.innerHTML = 'جلب';
}

async function updateManga() {
  const id = document.getElementById('editMangaId').value;
  const title = document.getElementById('editTitle').value.trim();
  if (!title) { showAlert('editAlert', '❌ أدخل عنوان المانجا!', 'error'); return; }
  try {
    await adminApi(`/api/admin/manga/${id}`, 'PUT', {
      title,
      author: document.getElementById('editAuthor').value.trim(),
      cover: document.getElementById('editCover').value.trim(),
      genres: document.getElementById('editGenres').value.trim(),
      description: document.getElementById('editDesc').value.trim(),
      type: document.getElementById('editType').value,
      status: document.getElementById('editStatus').value,
      is_hot: document.getElementById('editHot').checked,
      is_new: document.getElementById('editNew').checked,
    });
    showAlert('editAlert', '✅ تم حفظ التعديلات!', 'success');
    await loadMangaList();
    renderMangaTable();
  } catch(e) { showAlert('editAlert', '❌ خطأ في الحفظ', 'error'); }
}

// ======== ADS ========
let adsList = [];

async function loadAds() {
  try {
    const data = await adminApi('/api/admin/ads');
    adsList = data.ads || [];
    renderAdsList();
  } catch(e) {}
}

function renderAdsList() {
  const el = document.getElementById('adsList');
  if (!el) return;
  if (!adsList.length) {
    el.innerHTML = '<div style="text-align:center;padding:30px;color:var(--muted)">لا توجد إعلانات</div>';
    return;
  }
  const posLabels = {
    home_top: 'الرئيسية — أعلى', home_middle: 'الرئيسية — وسط',
    home_bottom: 'الرئيسية — أسفل', manga_top: 'صفحة المانجا — أعلى',
    manga_bottom: 'صفحة المانجا — أسفل', reader_top: 'القارئ — أعلى',
    reader_bottom: 'القارئ — أسفل'
  };
  el.innerHTML = `<div class="table-wrap"><table>
    <thead><tr><th>الصورة</th><th>العنوان</th><th>الموقع</th><th>الحالة</th><th>إجراءات</th></tr></thead>
    <tbody>${adsList.map(ad => `
      <tr>
        <td>${ad.image ? `<img src="${ad.image}" style="height:50px;border-radius:4px">` : '—'}</td>
        <td>${ad.title || '—'}</td>
        <td>${posLabels[ad.position] || ad.position}</td>
        <td>${ad.active ? '<span style="color:#22c55e">✅ نشط</span>' : '<span style="color:var(--muted)">⏸ متوقف</span>'}</td>
        <td><div class="td-actions">
          <button class="btn btn-blue btn-sm" onclick="toggleAd(${ad.id}, ${ad.active})">
            ${ad.active ? 'إيقاف' : 'تشغيل'}
          </button>
          <button class="btn btn-red btn-sm" onclick="deleteAd(${ad.id})">🗑️</button>
        </div></td>
      </tr>
    `).join('')}</tbody>
  </table></div>`;
}

function previewAd() {
  const url = document.getElementById('adImage').value.trim();
  if (url) {
    document.getElementById('adPreviewImg').src = url;
    document.getElementById('adPreviewWrap').style.display = 'block';
  } else {
    document.getElementById('adPreviewWrap').style.display = 'none';
  }
}

async function saveAd() {
  const image = document.getElementById('adImage').value.trim();
  if (!image) { showAlert('adsAlert', '❌ أدخل رابط الصورة!', 'error'); return; }
  try {
    await adminApi('/api/admin/ads', 'POST', {
      title: document.getElementById('adTitle').value.trim(),
      image,
      link: document.getElementById('adLink').value.trim(),
      position: document.getElementById('adPosition').value,
      active: document.getElementById('adActive').checked,
    });
    showAlert('adsAlert', '✅ تم حفظ الإعلان!', 'success');
    document.getElementById('adTitle').value = '';
    document.getElementById('adImage').value = '';
    document.getElementById('adLink').value = '';
    document.getElementById('adPreviewWrap').style.display = 'none';
    await loadAds();
  } catch(e) { showAlert('adsAlert', '❌ خطأ في الحفظ', 'error'); }
}

async function toggleAd(id, currentActive) {
  const ad = adsList.find(a => a.id === id);
  if (!ad) return;
  try {
    await adminApi(`/api/admin/ads/${id}`, 'PUT', { ...ad, active: !currentActive });
    await loadAds();
  } catch(e) {}
}

async function deleteAd(id) {
  if (!confirm('هل تريد حذف هذا الإعلان؟')) return;
  try {
    await adminApi(`/api/admin/ads/${id}`, 'DELETE');
    await loadAds();
  } catch(e) {}
}

// ======== VAULTS ========
async function loadVaults() {
  try {
    const data = await adminApi('/api/admin/vaults');
    vaultsList = data.vaults || [];
    renderVaultsList();
  } catch(e) {}
}

function renderVaultsList() {
  const el = document.getElementById('vaultsList');
  if (!vaultsList.length) {
    el.innerHTML = '<div style="text-align:center;padding:30px;color:var(--muted)">لا توجد Vaults — أضف أولاً!</div>';
    return;
  }
  el.innerHTML = vaultsList.map(v => `
    <div class="vault-card">
      <div class="vault-icon">🗄️</div>
      <div class="vault-info">
        <div class="vault-name">${v.name}</div>
        <div class="vault-url">${v.url}</div>
      </div>
      <div class="vault-actions">
        <button class="btn btn-red btn-sm" onclick="deleteVault(${v.id})">🗑️</button>
      </div>
    </div>
  `).join('');
}

async function addVault() {
  const name = document.getElementById('vName').value.trim();
  const url = document.getElementById('vUrl').value.trim();
  const api_key = document.getElementById('vKey').value.trim();
  if (!name || !url || !api_key) { showAlert('vaultAlert', '❌ أكمل جميع الحقول!', 'error'); return; }

  try {
    const res = await adminApi('/api/admin/vaults', 'POST', { name, url, api_key });
    if (res.success) {
      showAlert('vaultAlert', '✅ تم إضافة Vault بنجاح!', 'success');
      document.getElementById('vName').value = '';
      document.getElementById('vUrl').value = '';
      document.getElementById('vKey').value = '';
      await loadVaults();
    }
  } catch(e) { showAlert('vaultAlert', '❌ خطأ', 'error'); }
}

async function deleteVault(id) {
  if (!confirm('حذف هذا Vault؟')) return;
  await adminApi(`/api/admin/vaults/${id}`, 'DELETE');
  await loadVaults();
}

// ======== IMPORT CHAPTER ========
function fillSelects() {
  // Vaults
  const vaultSelect = document.getElementById('impVault');
  if (vaultSelect) {
    vaultSelect.innerHTML = '<option value="">-- اختر Vault --</option>' +
      vaultsList.map(v => `<option value="${v.id}">${v.name}</option>`).join('');
  }
  const impMVault = document.getElementById('impMVault');
  if (impMVault) {
    impMVault.innerHTML = '<option value="">-- اختر Vault --</option>' +
      vaultsList.map(v => `<option value="${v.id}">${v.name}</option>`).join('');
  }

  // Manga
  const mangaSel = document.getElementById('impManga');
  if (mangaSel) {
    mangaSel.innerHTML = '<option value="">-- اختر المانجا --</option>' +
      mangaList.map(m => `<option value="${m.id}">${m.title}</option>`).join('');
  }
  // قائمة ربط المانجا الموجودة في صفحة استيراد مانجا
  const impMExisting = document.getElementById('impMExisting');
  if (impMExisting) {
    impMExisting.innerHTML = '<option value="">-- جديدة أو مطابقة تلقائية --</option>' +
      mangaList.map(m => `<option value="${m.id}">${m.title}</option>`).join('');
  }
}

async function loadVaultMangaFolders() {
  const vId = document.getElementById('impVault').value;
  if (!vId) return;
  const wrap = document.getElementById('chapterFoldersWrap');
  wrap.innerHTML = '<div class="loading"><div class="spinner"></div></div>';

  try {
    const data = await adminApi('/api/admin/kvault/folders', 'POST', { vault_id: parseInt(vId) });
    const folders = data.folders || [];
    if (!folders.length) { wrap.innerHTML = '<div style="color:var(--muted);padding:20px;text-align:center">لا توجد مجلدات</div>'; return; }

    wrap.innerHTML = `
      <div style="margin-bottom:8px;font-size:13px;color:var(--muted)">اختر مجلد مانجا ثم مجلد الفصل:</div>
      <div class="folder-grid" id="mangaFolderGrid">
        ${folders.map(f => `<div class="folder-item" onclick="loadChapterFolders('${f}', this)"><div class="folder-item-icon">📁</div><div class="folder-item-name">${f}</div></div>`).join('')}
      </div>
      <div id="chFolderGrid" style="margin-top:10px;display:none">
        <div style="font-size:13px;color:var(--muted);margin-bottom:6px">اختر فصل:</div>
        <div class="folder-grid" id="chFolderInner"></div>
      </div>
    `;
  } catch(e) { wrap.innerHTML = '<div style="color:#ef4444">خطأ في الاتصال</div>'; }
}

async function loadChapterFolders(mangaPath, el) {
  document.querySelectorAll('#mangaFolderGrid .folder-item').forEach(i => i.classList.remove('selected'));
  el.classList.add('selected');

  const vId = document.getElementById('impVault').value;
  const chGrid = document.getElementById('chFolderGrid');
  const chInner = document.getElementById('chFolderInner');
  chGrid.style.display = 'block';
  chInner.innerHTML = '<div class="loading"><div class="spinner"></div></div>';

  try {
    const data = await adminApi('/api/admin/kvault/subfolders', 'POST', { vault_id: parseInt(vId), manga_path: mangaPath });
    const folders = data.folders || [];
    chInner.innerHTML = folders.map(f => {
      const full = `${mangaPath}/${f}`;
      return `<div class="folder-item" onclick="selectChapterFolder('${full}', this)"><div class="folder-item-icon">📑</div><div class="folder-item-name">${f}</div></div>`;
    }).join('') || '<div style="color:var(--muted);padding:10px">لا توجد فصول</div>';
  } catch(e) { chInner.innerHTML = '<div style="color:#ef4444">خطأ</div>'; }
}

function selectChapterFolder(path, el) {
  document.querySelectorAll('#chFolderInner .folder-item').forEach(i => i.classList.remove('selected'));
  el.classList.add('selected');
  document.getElementById('impFolder').value = path;

  // استخراج رقم الفصل تلقائياً
  const match = path.match(/(\d+(\.\d+)?)/g);
  if (match) document.getElementById('impChNum').value = match[match.length - 1];
}

async function previewChapter() {
  const vId = document.getElementById('impVault').value;
  const folder = document.getElementById('impFolder').value.trim();
  if (!vId || !folder) { alert('اختر Vault وأدخل مسار المجلد!'); return; }

  try {
    const data = await adminApi('/api/admin/kvault/preview', 'POST', { vault_id: parseInt(vId), folder_path: folder });
    const images = data.images || [];
    document.getElementById('previewCount').textContent = images.length;
    document.getElementById('previewStrip').innerHTML = images.slice(0,10).map(url =>
      `<img src="${url}" onerror="this.style.display='none'">`
    ).join('');
    document.getElementById('previewSection').style.display = 'block';
  } catch(e) { alert('❌ خطأ في جلب الصور'); }
}

async function importChapter() {
  const vId = document.getElementById('impVault').value;
  const manga_id = document.getElementById('impManga').value;
  const folder = document.getElementById('impFolder').value.trim();
  const chNum = document.getElementById('impChNum').value;
  const chName = document.getElementById('impChName').value.trim();

  if (!vId || !manga_id || !folder || !chNum) {
    showAlert('impAlert', '❌ أكمل جميع الحقول المطلوبة!', 'error'); return;
  }

  const btn = document.getElementById('impBtn');
  btn.disabled = true; btn.innerHTML = '<div class="spinner"></div> جاري الاستيراد...';

  try {
    const res = await adminApi('/api/admin/kvault/import-chapter', 'POST', {
      vault_id: parseInt(vId), manga_id: parseInt(manga_id),
      folder_path: folder, chapter_number: parseFloat(chNum),
      chapter_name: chName || `الفصل ${chNum}`,
    });

    if (res.success) {
      showAlert('impAlert', `✅ تم استيراد الفصل ${chNum} بنجاح! (${res.images_count} صورة)`, 'success');
    } else {
      showAlert('impAlert', '❌ ' + (res.error || 'خطأ'), 'error');
    }
  } catch(e) { showAlert('impAlert', '❌ خطأ في الاتصال', 'error'); }

  btn.disabled = false; btn.innerHTML = '📥 استيراد إلى الموقع';
}

// ======== IMPORT MANGA ========
async function loadMangaFoldersList() {
  const vId = document.getElementById('impMVault').value;
  const sel = document.getElementById('impMFolder');
  if (!vId) {
    sel.innerHTML = '<option value="">-- اختر مانجا --</option>';
    return;
  }
  sel.innerHTML = '<option value="">⏳ جاري التحميل...</option>';
  sel.disabled = true;
  try {
    const data = await adminApi('/api/admin/kvault/folders', 'POST', { vault_id: parseInt(vId) });
    const folders = data.folders || [];
    if (!folders.length) {
      sel.innerHTML = '<option value="">❌ لا توجد مجلدات في هذا Vault</option>';
      showAlert('importMangaAlert', '⚠️ لم يتم العثور على مجلدات — تأكد من رابط الـ Vault والـ API Key', 'error');
    } else {
      sel.innerHTML = '<option value="">-- اختر مانجا --</option>' +
        folders.map(f => `<option value="${f}">${f}</option>`).join('');
      showAlert('importMangaAlert', `✅ تم تحميل ${folders.length} مجلد`, 'success');
    }
  } catch(e) {
    sel.innerHTML = '<option value="">❌ خطأ في الاتصال</option>';
    showAlert('importMangaAlert', `❌ خطأ في الاتصال بالـ Vault: ${e.message}`, 'error');
  } finally {
    sel.disabled = false;
  }
}

async function importMangaFull() {
  const vId = document.getElementById('impMVault').value;
  const mangaPath = document.getElementById('impMFolder').value;
  const title = document.getElementById('impMTitle').value.trim();
  const existingMangaId = document.getElementById('impMExisting').value;
  if (!vId || !mangaPath) { showAlert('importMangaAlert', '❌ اختر Vault ومانجا!', 'error'); return; }

  document.getElementById('importMangaLog').style.display = 'block';
  const log = document.getElementById('importLog');
  log.innerHTML = '<span class="log-info">⏳ جاري الاستيراد وجلب المعلومات...</span><br>';

  try {
    const res = await adminApi('/api/admin/kvault/import-manga', 'POST', {
      vault_id: parseInt(vId), manga_path: mangaPath,
      manga_title: title || mangaPath,
      existing_manga_id: existingMangaId ? parseInt(existingMangaId) : null,
    });

    if (res.success) {
      log.innerHTML += `<span class="log-ok">✅ تم إنشاء المانجا: ${mangaPath}</span><br>`;
      if (res.manga_info?.found) {
        log.innerHTML += `<span class="log-info">📖 معلومات من MangaDex: ${res.manga_info.title}</span><br>`;
      } else {
        log.innerHTML += `<span class="log-warn">⚠️ لم يتم العثور على معلومات في MangaDex</span><br>`;
      }
      log.innerHTML += `<span class="log-ok">📑 تم استيراد ${res.chapters_imported} فصل</span><br>`;
      log.innerHTML += `<br><span class="log-ok">🎉 اكتمل! <a href="/manga.html?slug=${res.slug}" target="_blank" style="color:inherit">عرض المانجا →</a></span>`;
      await loadMangaList();
    } else {
      log.innerHTML += `<span class="log-err">❌ ${res.error}</span>`;
    }
  } catch(e) { log.innerHTML += `<span class="log-err">❌ خطأ: ${e.message}</span>`; }
}

// ======== AUTO SCAN ========
async function startScan() {
  const btn = document.getElementById('scanBtn');
  btn.disabled = true; btn.innerHTML = '<div class="spinner"></div> جاري المسح...';
  document.getElementById('scanLogCard').style.display = 'block';
  const log = document.getElementById('scanLog');
  log.innerHTML = '<span class="log-info">🔍 جاري مسح جميع الـ K-Vaults...</span><br>';

  try {
    const res = await adminApi('/api/admin/kvault/auto-scan', 'POST', {});
    const report = res.report || [];

    if (!report.length) {
      log.innerHTML += '<span class="log-warn">⚠️ لا توجد فصول جديدة — كل شيء محدث!</span>';
    } else {
      report.forEach(r => {
        log.innerHTML += `<span class="log-ok">✅ ${r.manga} — ${r.new_chapters} فصل جديد (${r.vault})</span><br>`;
      });
      log.innerHTML += `<br><span class="log-ok">🎉 تم استيراد ${report.reduce((s,r) => s+r.new_chapters, 0)} فصل جديد!</span>`;
    }
    await loadMangaList();
  } catch(e) { log.innerHTML += `<span class="log-err">❌ خطأ: ${e.message}</span>`; }

  btn.disabled = false; btn.innerHTML = '🔄 بدء المسح الآن';
}

// ======== SETTINGS ========
async function loadAdminSettings() {
  try {
    const s = await adminApi('/api/admin/settings');
    if (s.site_name) document.getElementById('setSiteName').value = s.site_name;
    if (s.site_description) document.getElementById('setSiteDesc').value = s.site_description;
    if (s.hero_style) document.getElementById('setHeroStyle').value = s.hero_style;
    if (s.chapters_per_page) document.getElementById('setChPerPage').value = s.chapters_per_page;
    if (s.primary_color) document.getElementById('setPrimary').value = s.primary_color;
    if (s.secondary_color) document.getElementById('setSecondary').value = s.secondary_color;
    if (s.bg_color) document.getElementById('setBg').value = s.bg_color;
    if (s.card_color) document.getElementById('setCard').value = s.card_color;
  } catch(e) {}
}

async function saveSettings() {
  try {
    await adminApi('/api/admin/settings', 'POST', {
      site_name: document.getElementById('setSiteName').value,
      site_description: document.getElementById('setSiteDesc').value,
      hero_style: document.getElementById('setHeroStyle').value,
      chapters_per_page: document.getElementById('setChPerPage').value,
    });
    showAlert('settingsAlert', '✅ تم حفظ الإعدادات!', 'success');
  } catch(e) { showAlert('settingsAlert', '❌ خطأ', 'error'); }
}

async function saveAppearance() {
  try {
    await adminApi('/api/admin/settings', 'POST', {
      primary_color: document.getElementById('setPrimary').value,
      secondary_color: document.getElementById('setSecondary').value,
      bg_color: document.getElementById('setBg').value,
      card_color: document.getElementById('setCard').value,
    });
    showAlert('appearanceAlert', '✅ تم حفظ المظهر!', 'success');
  } catch(e) { showAlert('appearanceAlert', '❌ خطأ', 'error'); }
}

async function resetAppearance() {
  await adminApi('/api/admin/settings', 'POST', {
    primary_color: '#e63946', secondary_color: '#ff6b6b',
    bg_color: '#0a0a0f', card_color: '#16161f',
  });
  await loadAdminSettings();
  showAlert('appearanceAlert', '✅ تم استعادة الافتراضي!', 'success');
}

// ======== HELPERS ========
async function adminApi(path, method = 'GET', body = null) {
  const opts = { method, headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` } };
  if (body) opts.body = JSON.stringify(body);
  const res = await fetch(path, opts);
  return res.json();
}

function showAlert(id, msg, type) {
  const el = document.getElementById(id);
  if (!el) return;
  el.innerHTML = msg;
  el.className = `alert alert-${type} show`;
  setTimeout(() => el.classList.remove('show'), 5000);
}

function typeLabel(t) {
  return { manga: '🇯🇵 مانجا', manhwa: '🇰🇷 مانهوا', manhua: '🇨🇳 مانهوا صينية' }[t] || t || 'مانهوا';
}

document.getElementById('mCover').addEventListener('input', function() {
  if (this.value) {
    document.getElementById('mCoverImg').src = this.value;
    document.getElementById('mCoverPreview').style.display = 'block';
  }
});
</script>
